# cmake options of GEANT4 V11.4.3, read by recipes/GEANT4/build.sh (one per line; '#' starts a comment).
# The install prefix is added by build.sh.
#
# Same features as V11.1.3 (geant4-config --features): multithreading, builtin CLHEP, zlib and PTL, GDML,
# Qt (with Qt3D, enabled automatically when found), OpenGL X11, and the data sets installed in the prefix.
# Qt5 is asked for explicitly: 11.4 prefers Qt6, but the nodes have Qt5 (packages/geant4.yml).

-DCMAKE_BUILD_TYPE=Release
-DCMAKE_CXX_STANDARD=17
-DGEANT4_BUILD_MULTITHREADED=ON
-DGEANT4_INSTALL_DATA=ON
-DGEANT4_INSTALL_EXAMPLES=ON
-DGEANT4_USE_GDML=ON
-DGEANT4_USE_QT=ON
-DGEANT4_USE_QT_QT5=ON
-DGEANT4_USE_OPENGL_X11=ON
-DGEANT4_USE_SYSTEM_CLHEP=OFF
-DGEANT4_USE_SYSTEM_ZLIB=OFF
-DGEANT4_USE_SYSTEM_PTL=OFF
