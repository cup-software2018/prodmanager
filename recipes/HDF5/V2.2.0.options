# cmake options of HDF5 V2.2.0, read by recipes/HDF5/build.sh (one per line; '#' starts a comment).
# The install prefix is added by build.sh.
#
# Same features as V1.14.2 (lib/libhdf5.settings): C, C++ and high-level libraries, shared and static, tools,
# deflate (system zlib), no szip, no Fortran/Java/parallel, not thread-safe, deprecated symbols kept.
# The libraries go to lib/ as in V1.14.2 (the modulefile puts <prefix>/lib into LD_LIBRARY_PATH); 2.x would
# otherwise use lib64 on AlmaLinux. The library's own tests are built and run by build.sh; examples are not.

-DCMAKE_BUILD_TYPE=Release
-DCMAKE_INSTALL_LIBDIR=lib
-DBUILD_SHARED_LIBS=ON
-DBUILD_STATIC_LIBS=ON
-DBUILD_TESTING=ON
-DHDF5_BUILD_EXAMPLES=OFF
-DHDF5_BUILD_CPP_LIB=ON
-DHDF5_BUILD_HL_LIB=ON
-DHDF5_BUILD_TOOLS=ON
-DHDF5_BUILD_FORTRAN=OFF
-DHDF5_BUILD_JAVA=OFF
-DHDF5_ENABLE_PARALLEL=OFF
-DHDF5_ENABLE_THREADSAFE=OFF
-DHDF5_ENABLE_ZLIB_SUPPORT=ON
-DZLIB_USE_EXTERNAL=OFF
-DHDF5_ENABLE_SZIP_SUPPORT=OFF
-DHDF5_ENABLE_DEPRECATED_SYMBOLS=ON
